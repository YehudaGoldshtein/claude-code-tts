# Machine-local TTS config. Copy to .env (untracked) and adjust.
# Every value is optional — these are the defaults used when .env is absent.

# Address the local Kokoro server binds to / the hooks call
TTS_HOST=127.0.0.1
TTS_PORT=8880

# Default voice and speaking speed (see kokoro-onnx docs for voice names,
# e.g. af_heart, af_bella, am_adam, bf_emma, bm_george)
TTS_VOICE=af_heart
TTS_SPEED=1.0

# External media player used to play each clip (gives pause / seek / stop).
# {file} is replaced with the WAV path. Leave blank to auto-detect:
# VLC, then Windows Media Player, then the OS default .wav handler.
# Examples:
#   TTS_PLAYER="C:\Program Files\VideoLAN\VLC\vlc.exe" --no-video --play-and-exit "{file}"
#   TTS_PLAYER=wmplayer.exe "{file}"
TTS_PLAYER=
