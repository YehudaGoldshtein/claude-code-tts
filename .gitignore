# machine-local config — copy .env.example to .env and edit
.env

# python virtualenv — recreated by install.ps1
.venv/
__pycache__/

# Kokoro model files (~350 MB) — downloaded by install.ps1
*.onnx
*.bin

# runtime state written by voice.ps1 / the hook
voice.off
voice.level

# cached audio of the last spoken clip — used by /tts replay
last.wav
install.log

# rotating server logs
logs/
server-debug.log*
